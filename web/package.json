{
  "name": "hivedesk-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:config": "node scripts/validate-config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate:config && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:live": "node scripts/check-live.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "browsers": "playwright install chromium webkit"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.4.0",
    "@tanstack/react-query": "5.104.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.5",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
